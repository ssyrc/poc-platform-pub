# Copy this file to .env and fill in site-specific values.
# .env is sourced as a shell file by start_platform.sh / scripts/common.sh.

# Platform paths
POC_PLATFORM_ROOT=/opt/poc-platform
MLPERF_ROOT=/opt/poc-platform
MLPERF_DATA_ROOT=/opt/poc-platform/data
WHEELHOUSE=/opt/poc-platform/files

# Where run logs are written, on whichever host runs the container. Defaults to
# POC_PLATFORM_ROOT, so logs follow the platform; set this to put them
# somewhere else. Each suite appends its own subdirectory
# (mlperf_logs_train_v51, mlperf_logs_infer_v60, ...), and --log-root on the
# command line overrides it. On multi-node runs every node writes under this
# root, so point it at shared storage to keep a run's logs together.
#MLPERF_LOG_ROOT=/opt/poc-platform

# Default hosts file for run_multi_node.sh and nccl_probe.sh, used when neither
# --hosts nor --hosts-file is given. One host per line, and the order sets the
# ranks -- the first line is rank 0 and becomes MASTER_ADDR. Blank lines and
# anything after '#' are ignored; commas and stray whitespace are accepted.
#MLPERF_HOSTFILE=/opt/poc-platform/hostfile

# ---------------------------------------------------------------------------
# Networks
# ---------------------------------------------------------------------------
# A run targets one network, picked in the UI. The UI only ever sends the id;
# the bastion chain behind it is configured here, so addresses stay out of the
# browser and out of run history.
#
# Ids come from NETWORKS in frontend/index.html. The variable name is the id
# upper-cased with non-alphanumerics as underscores.

# S 슈퍼컴망 -- reached directly, the default
#MLPERF_NET_S_SC_JUMP=

# S DDZ망 -- not configured yet
#MLPERF_NET_S_DDZ_JUMP=

# H HPC센터 -- two bastions, in order, exactly as `ssh -J` takes it
#MLPERF_NET_H_HPC_JUMP=root@bastion1,root@bastion2
# Every connection crosses both, so give it longer than the default 8s
#MLPERF_NET_H_HPC_SSH_OPTS=-o ConnectTimeout=20

# ---------------------------------------------------------------------------
# Reaching hosts behind bastions -- lower level, for cases a network id does
# not cover (one run spanning two networks). MLPERF_SSH_JUMP overrides the
# network selection; MLPERF_SSH_JUMP_HOSTS scopes it by glob pattern, and
# without patterns it applies to every host.
# ---------------------------------------------------------------------------
#MLPERF_SSH_JUMP=root@bastion1,root@bastion2
#MLPERF_SSH_JUMP_HOSTS=10.0.0.*,10.0.1.*
#MLPERF_SSH_OPTS=-o ConnectTimeout=20 -i /root/.ssh/b300_key
