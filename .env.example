# Copy this file to .env and fill in site-specific values.
# .env is sourced as a shell file by start_platform.sh / scripts/common.sh.

# Platform paths
POC_PLATFORM_ROOT=/opt/poc-platform
MLPERF_ROOT=/opt/poc-platform
MLPERF_DATA_ROOT=/opt/poc-platform/data
WHEELHOUSE=/opt/poc-platform/files

# Where run logs are written, on whichever host runs the container. Defaults to
# POC_PLATFORM_ROOT, so logs follow the platform; set this to put them
# somewhere else. Each suite appends its own subdirectory
# (mlperf_logs_train_v51, mlperf_logs_infer_v60, ...), and --log-root on the
# command line overrides it. On multi-node runs every node writes under this
# root, so point it at shared storage to keep a run's logs together.
#MLPERF_LOG_ROOT=/opt/poc-platform

# Extra directories to search for Docker image tars when the file is not under
# ${MLPERF_DATA_ROOT}/dockerimgs. Colon-separated, searched by file name, in
# order. Useful when the tars live on a shared management server or a mount
# that differs between hosts.
# POC_PLATFORM_DOCKERIMG_DIRS=/mnt/share/poc-platform/data/dockerimgs:/opt/another/dockerimgs
POC_PLATFORM_DOCKERIMG_DIRS=

# Warewulf / Kubernetes management
WW_API_BASE=http://127.0.0.1:8897
WW_API_PREFIX=/api
WW_API_TOKEN=
WW_AUTH_HEADER=
WW_BASIC_USER=
WW_BASIC_PASSWORD=
WW_MANAGER_HOST=localhost
WW_MANAGER_SSH_USER=root
K8S_MASTER_NODE=localhost
K8S_MASTER_IP=
K8S_SSH_USER=root
K8S_USE_SSH=auto
K8S_KUBECONFIG=/etc/kubernetes/admin.conf
LLMD_NAMESPACE=llm-d-quickstart
LLMD_PROXY_URL=http://127.0.0.1:8896

# Optional defaults shown in the Warewulf node-add UI
CLUSTER_DEFAULT_GATEWAY=
CLUSTER_DEFAULT_NETMASK=255.255.255.0
CLUSTER_DEFAULT_MTU=9000
CLUSTER_DEFAULT_PRIMARYNET=eth

# Docker bootstrap / internal registry
# Leave empty when hosts already have Docker configured or only public registries are used.
DOCKER_RPM_DIR=
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_INSECURE_REGISTRIES=

# Image prefixes. Defaults are public registries; override for an internal proxy/mirror.
DOCKER_HUB_IMAGE_PREFIX=docker.io
DOCKER_HUB_PULL_PREFIX=docker.io
NVCR_PULL_PREFIX=nvcr.io

# Optional host-side artifact locations used by vLLM / PD workloads
VLLM_HOST_INFER_DIR=/opt/poc-platform/inference
VLLM_HOST_MODELS_DIR=/opt/poc-platform/models
VLLM_ENCODINGS_DIR=/opt/poc-platform/encodings
PD_HOST_MODELS_DIR=/opt/poc-platform/models
PD_ENCODINGS_DIR=/opt/poc-platform/encodings
PD_VLLM_SRC=/opt/poc-platform/vllm
PD_DATASET_PATH=/opt/poc-platform/datasets/ShareGPT_V3_unfiltered_cleaned_split.json

# Optional MLPerf multi-node network overrides.
# Leave these empty to use per-host GPU/NIC auto-detection.
MASTER_ADDR=
MASTER_PORT=29500
NCCL_IB_HCA=
NCCL_SOCKET_IFNAME=
NCCL_IB_DISABLE=
