### IB 끄고, TCP socket으로 멀티노드 NCCL 되나 확인
NCCL_NET_PLUGIN=none \
NCCL_IB_DISABLE=1 \
NCCL_DEBUG=INFO \
UCX_HANDLE_ERRORS=none \
UCX_ERROR_SIGNALS= \
PYTHONFAULTHANDLER=1 \
./scripts/nccl_probe.sh --hosts $N1,$N2 --image $IMG

