# 한 줄에 하나씩. 순서가 rank를 정합니다 -- 첫 줄이 rank 0이고 MASTER_ADDR가 됩니다.
# '#' 뒤와 빈 줄은 무시됩니다. 콤마와 여분의 공백도 허용합니다.
#
#   ./scripts/run_multi_node.sh --hosts-file hostfile ...
#   ./scripts/nccl_probe.sh     --hosts-file hostfile --image <repo:tag>
#
# .env 에 MLPERF_HOSTFILE=/path/to/hostfile 를 두면 플래그 없이도 읽습니다.

